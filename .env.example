# Copy to .env and fill in values. .env is ignored by git.
# Load with: uv run --env-file .env <command>   (or export UV_ENV_FILE=.env)

# Hugging Face access token. Required only for gated datasets/models
# (e.g. allenai/wildguardmix, sorry-bench). Secret: never commit or log.
HF_TOKEN=

# Hugging Face cache location. Keep commented out to use the default
# (~/.cache/huggingface), which lets this repo reuse already downloaded models.
# An empty value is NOT the same as unset.
# HF_HOME=/path/to/cache

# Disable Hugging Face telemetry.
HF_HUB_DISABLE_TELEMETRY=1

# Set to 1 while running experiments to forbid network access and use only
# pinned, already cached files.
HF_HUB_OFFLINE=0

# Where datasets and run outputs live. Relative paths resolve from the repo root.
GUARDBENCH_DATA_DIR=data
GUARDBENCH_RUNS_DIR=runs

# GPU selection (optional). Keep commented out to see all GPUs.
# An empty value hides every GPU.
# CUDA_VISIBLE_DEVICES=0

# --- Local vLLM server (compose.yaml) ---
# Host directory mounted as the container's Hugging Face cache (default: ~/.cache/huggingface).
HF_CACHE_DIR=
VLLM_MODEL=Qwen/Qwen3-4B
VLLM_MODEL_REVISION=1cfa9a7208912126459214e8b04321603b3df60c
VLLM_PORT=8000
# Fraction of total GPU memory vLLM may use. The GPU is shared; keep it below the free memory.
VLLM_GPU_MEMORY_UTILIZATION=0.65
VLLM_MAX_MODEL_LEN=8192
# Client base URL. Defaults to http://127.0.0.1:${VLLM_PORT}.
VLLM_BASE_URL=
